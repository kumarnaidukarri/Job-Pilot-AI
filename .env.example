# ── Required ──
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
GROQ_API_KEY=            # console.groq.com (free)
GEMINI_API_KEY=          # aistudio.google.com (free)
GMAIL_ADDRESS=           # sender Gmail
GMAIL_APP_PASSWORD=      # Gmail App Password (not the normal password)
NOTIFY_EMAIL=            # where digests go (comma-separated ok); default = GMAIL_ADDRESS

# ── Instant alerts (strongly recommended) ──
TELEGRAM_BOT_TOKEN=      # @BotFather -> /newbot
TELEGRAM_CHAT_ID=        # python tools/telegram_setup.py

# ── Optional extra free LLM capacity (any you add are used automatically) ──
OPENROUTER_API_KEY=      # openrouter.ai — free models
CEREBRAS_API_KEY=        # cloud.cerebras.ai
MISTRAL_API_KEY=         # console.mistral.ai — free "Experiment" plan
NVIDIA_API_KEY=          # build.nvidia.com
CLOUDFLARE_API_TOKEN=    # dash.cloudflare.com -> Workers AI
CLOUDFLARE_ACCOUNT_ID=
OLLAMA_URL=              # e.g. http://localhost:11434 when running on the laptop with Ollama
